    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
