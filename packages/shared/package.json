{
  "name": "@bookkeeper/shared",
  "version": "0.1.0",
  "private": true,
  "description": "前后端共享：金额精确运算、科目常量、领域枚举、校验规则",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
