{
  "name": "@bookkeeper/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "小企业自动记账系统 — 前端（Vue3 + Element Plus）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && node ../../tools/check-routes.mjs && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && node ../../tools/check-routes.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bookkeeper/shared": "workspace:*",
    "axios": "^1.7.9",
    "decimal.js": "^10.4.3",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
