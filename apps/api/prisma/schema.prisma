/// 自动记账规则
model JournalRule {
  id       String      @id @default(uuid())
  entityId String
  /// 稳定的规则标识，用于内置规则的升级匹配
  code     String
  name     String
  priority Int         @default(100) /// 数字小者先匹配
  enabled  Boolean     @default(true)
  trigger  RuleTrigger

  /// 条件树（JSON），见 design/05 第 2.1 节
  conditions Json
  /// 分录模板（JSON），见 design/05 第 2.2 节
  template   Json

  confidence Decimal @db.Decimal(5, 4) @default(0.9500)
  /// ★ 是否允许免审核直接过账。默认关闭 —— 一张错凭证的排查成本远高于点一下确认。
  autoPost   Boolean @default(false)
  /// 自动过账的金额上限
  autoPostMaxAmount Decimal? @db.Decimal(18, 2)

  isSystem   Boolean   @default(false)
  hitCount   Int       @default(0)
  lastHitAt  DateTime?
  version    Int       @default(1)
  remark     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, code])
  @@index([entityId, trigger, priority])
  @@map("journal_rule")
}

/// 用户纠错沉淀 —— 让系统越用越准（L2 层）
model ClassificationOverride {
  id       String @id @default(uuid())
  entityId String
  /// 归一化特征键，如 "supplier:91310000XXXX"
  featureKey    String
  supplierTaxNo String?
  keyword       String?
  amountBucket  String? /// 金额区间桶

  accountId    String
  taxTreatment String? /// DEDUCTIBLE | NON_DEDUCTIBLE
  hitCount     Int      @default(0)
  lastUsedAt   DateTime?
  /// 从哪张凭证学来的
  createdFrom  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, featureKey])
  @@index([entityId, supplierTaxNo])
  @@map("classification_override")
}

/// 科目 ↔ 报表/申报表行项目映射（可配置，避免硬编码）
model AccountMapping {
  id       String @id @default(uuid())
  entityId String
  /// BALANCE_SHEET | INCOME_STATEMENT | CASHFLOW | VAT_MAIN | VAT_ANNEX1 | VAT_ANNEX2 | CIT
  purpose  String
  itemCode String /// 报表/申报表行项目代码
  accountId String
  sign     Int    @default(1) /// 取数符号 +1 / -1

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, purpose, itemCode, accountId])
  @@map("account_mapping")
}

