/// AI 调用日志（含成本与可复现性）
model AiCallLog {
  id       String  @id @default(uuid())
  entityId String?
  /// EXTRACT_INVOICE | EXTRACT_CONTRACT | SUGGEST_ACCOUNT | ANOMALY
  purpose  String
  provider String
  model    String
  /// packages/prompts 中的模板标识与版本
  promptKey     String
  promptVersion String
  /// 输入哈希：去重调用、复现问题
  requestHash   String

  rawResponse      Json?
  promptTokens     Int?
  completionTokens Int?
  costEstimate     Decimal? @db.Decimal(12, 6)
  latencyMs        Int
  success          Boolean
  errorMessage     String?
  documentId       String?

  createdAt DateTime @default(now())

  @@index([entityId, purpose, createdAt])
  @@index([requestHash])
  @@map("ai_call_log")
}

/// 抽取结果（含字段级置信度）
model ExtractionResult {
  id         String @id @default(uuid())
  entityId   String
  documentId String
  targetType String /// INVOICE | BANK_SLIP | CONTRACT | BANK_STATEMENT
  /// { field: { value, confidence, sourcePage, bbox } }
  fields     Json
  overallConfidence Decimal @db.Decimal(5, 4)
  rawText    String?
  aiCallLogId String?
  schemaVersion String @default("v1")

  reviewedBy  String?
  reviewedAt  DateTime?
  /// 人工改了什么 —— 优化提示词与规则的唯一可靠数据源
  corrections Json?

  createdAt DateTime @default(now())

  entity   Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([entityId, documentId])
  @@map("extraction_result")
}

/// 风险规则（无需改代码即可定义）
model RiskRule {
  id       String @id @default(uuid())
  entityId String
  code     String
  name     String
  category RiskCategory
  engine   String @default("SQL") /// SQL | AI | SQL+AI
  /// 阈值与参数
  definition Json
  level    RiskLevel @default(WARNING)
  enabled  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, code])
  @@map("risk_rule")
}

/// 风险提示实例
model RiskAlert {
  id       String @id @default(uuid())
  entityId String
  ruleCode String
  level    RiskLevel
  category RiskCategory
  periodId String?

  subjectType String /// INVOICE | VOUCHER | PARTNER | CONTRACT | PERIOD | ACCOUNT
  subjectId   String?

  title    String
  detail   String?
  /// 建议动作 —— 必须给出下一步
  suggestion String?
  /// 具体数字证据
  evidence Json?

  status    RiskAlertStatus @default(OPEN)
  handledBy String?
  handledAt DateTime?
  /// 忽略/处理理由（必填）
  handleNote String?

  createdAt DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId, status, level])
  @@index([entityId, periodId])
  @@map("risk_alert")
}

// =============================================================================
//  ⑦ 系统
// =============================================================================

/// 用户（自然人）
///
/// ★ 平台级账号，不属于任何单一主体 —— 一个人可以同时是多家公司的实控人或会计。
///   所以「在某家公司是什么角色」不放在这里，放在 Membership。
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  phone        String?

  /// 账号性质：PERSONAL 个人自用 / COMPANY_STAFF 企业员工
  /// ★ 它只影响注册时的引导文案与默认权限预设，不决定实际权限 ——
  ///   实际权限一律看 Membership.role，避免"账号性质"与"实际角色"两套口径打架。
  accountType String @default("PERSONAL")

  /// 平台级管理员（可跨主体查看，用于运维排障）。
  /// 与 Membership.role=OWNER 是两件事：后者只管一家公司。
  isPlatformAdmin Boolean @default(false)

  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]

  @@map("app_user")
}

/// 用户与主体的关联（谁能进哪家公司、以什么身份）
///
/// ★ 为什么必须做成关系表，而不是在 User 上放一个 entityIds 字符串数组：
///   ① 数组没有外键 —— 可以塞进任何不存在的 id，删了主体也不会清理
///   ② 数组表达不了"在这家公司是什么角色"，而角色是权限判定的核心
///   ③ 权限校验要按 (userId, entityId) 查一行，关系表上一个联合唯一索引就够，
///      数组则只能全表扫
model Membership {
  id       String @id @default(uuid())
  userId   String
  entityId String

  /// OWNER 实控人（全部权限，含删除主体）
  /// ACCOUNTANT 会计（记账、结账、报税，不能删除主体）
  /// VIEWER 只读（看账、看报表，不能改）
  role String @default("OWNER")

  /// 谁邀请进来的（实控人注册时为空）
  invitedBy String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
  @@index([entityId, role])
  @@index([userId, isActive])
  @@map("membership")
}

/// 审计日志：只追加，不修改（数据库触发器强制）
model AuditLog {
  id       String  @id @default(uuid())
  entityId String?
  /// 操作人。
  ///
  /// ★ 刻意**不加**外键约束，保留为裸字符串：
  ///   审计日志是"只追加、不可改"的证据链，它必须在用户被删除后依然存在 ——
  ///   加了外键就只能写真实用户 id，且删用户要么失败要么把日志一起删掉，
  ///   两者都会破坏审计完整性。系统用户（system）也会写进这里。
  userId   String?
  /// 操作人显示名（冗余存一份）：用户改名或删号后，历史日志仍能显示"当时是谁"
  userName String?
  /// CREATE | UPDATE | DELETE | POST | APPROVE | CLOSE | REOPEN | EXPORT | CONFIG
  /// | LOGIN | LOGOUT | LOGIN_FAILED | REGISTER | PASSWORD_CHANGE | MEMBER_ADD | MEMBER_ROLE
  action      String
  subjectType String
  subjectId   String
  beforeData  Json?
  afterData   Json?
  /// 关键操作必填理由
  reason    String?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([entityId, subjectType, subjectId])
  @@index([createdAt])
  @@map("audit_log")
}

/// 后台作业队列（PostgreSQL 即队列：FOR UPDATE SKIP LOCKED）
model JobQueue {
  id       String    @id @default(uuid())
  entityId String?
  /// EXTRACT_DOCUMENT | AUTO_DRAFT_INVOICE | REBUILD_BALANCE | RISK_SCAN | ...
  kind     String
  payload  Json
  status   JobStatus @default(PENDING)
  priority Int       @default(100)

  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  lockedBy    String?
  lockedAt    DateTime?
  availableAt DateTime @default(now())
  lastError   String?
  result      Json?

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status, availableAt, priority])
  @@map("job_queue")
}

/// 系统配置（税率表、开关等可变参数）
model SystemConfig {
  id       String @id @default(uuid())
  entityId String?
  key      String
  value    Json
  remark   String?

  updatedAt DateTime @updatedAt

  @@unique([entityId, key])
  @@map("system_config")
}


// =============================================================================
//  ⑧ 历史数据重建
// =============================================================================

/// 导入批次：一次上传的全部记录
// ============================================================================
//  税务政策库（月度检索政策的落点）
// ============================================================================

/// 检索任务的一次执行记录
///
/// ★ 每次执行都留痕：什么时候跑的、查了哪些来源、拿到几条、有没有失败。
///   政策检索最忌讳"看起来跑了但什么都没拿到" —— 没有执行记录就无法分辨
///   "本期确实没有新政策" 与 "抓取全挂了"。
model TaxPolicyFetchRun {
  id       String @id @default(uuid())
  /// 报税地（如 CN-JL-JL 吉林市 / CN-GENERAL 国家层面）
  jurisdiction String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  /// SUCCESS | PARTIAL | FAILED
  status       String    @default("RUNNING")
  sourcesTried   Int @default(0)
  sourcesFailed  Int @default(0)
  policiesFound  Int @default(0)
  policiesNew    Int @default(0)
  policiesChanged Int @default(0)
  /// 每个来源的结果明细：[{source, ok, httpStatus?, itemCount, error?}]
  sourceResults Json?
  warnings      Json?
  errorMessage  String?
  /// 是否由定时任务自动触发
  triggeredBy   String @default("SCHEDULED")

  createdAt DateTime @default(now())

  @@index([jurisdiction, startedAt])
  @@map("tax_policy_fetch_run")
}

/// 一条税务政策
model TaxPolicyRecord {
  id String @id @default(uuid())

  /// 报税地：政策有地域性（附加税费率、地方优惠各地不同）
  jurisdiction String
  /// 发布机关（如"财政部 税务总局"、"吉林省税务局"）
  issuer String?

  /// 政策标题（原文照抄，不改写 —— 改写会引入理解偏差）
  title String
  /// 官方来源链接
  sourceUrl String
  /// 来源站点名（便于判断权威性）
  sourceName String?
  /// 文号（如"财政部 税务总局公告2023年第12号"）
  documentNo String?

  /// 发文日期
  publishedAt DateTime? @db.Date
  /// 施行日期（★ 判断"现在适用哪条"的关键）
  effectiveFrom DateTime? @db.Date
  /// 失效日期（null 表示未见明确失效）
  effectiveTo DateTime? @db.Date

  /// 政策正文原文（截断保存，用于追溯 —— 只存摘要会丢失免责与限定条件）
  rawExcerpt String?
  /// 抓取到的完整原文（可能很大，单独存放）
  rawContent String?
  /// ★ 必须记录抓取时间：政策会改，不同时间看到的同一链接内容可能不同
  fetchedAt DateTime @default(now())

  /// 内容哈希：判断"这条政策有没有变过"
  contentHash String

  /// ★ 政策状态。只有基于 effectiveFrom/effectiveTo 推算，不做主观判断
  /// EFFECTIVE 现行有效 | UPCOMING 尚未施行 | EXPIRED 已失效
  status String @default("UPCOMING")

  /// 与哪些税种相关：VAT / CIT / SURTAX / STAMP_DUTY / IIT / OTHER
  taxTypes String[]
  /// 命中的关键词（便于用户快速判断是否与自己相关）
  keywords String[]

  /// ★ 需要人工阅读确认（系统不做适用性判断）
  needsReview Boolean @default(true)
  /// 人工确认后可以置为已读
  reviewedAt DateTime?
  reviewedBy String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 同一个来源链接 + 报税地只保留一条，内容变化时更新
  @@unique([jurisdiction, sourceUrl])
  @@index([jurisdiction, effectiveFrom])
  @@index([status, effectiveFrom])
  @@index([needsReview])
  @@map("tax_policy_record")
}
model HistoryImportBatch {
  id       String            @id @default(uuid())
  entityId String
  sourceType HistorySourceType
  fileName String?
  fileHash String? /// 文件内容哈希，防止同文件重复导入
  rowCount Int               @default(0)
  /// AI 推断出的表头映射：[{source:"开票日期", target:"invoiceDate", confidence:0.98, reason:"..."}]
  columnMapping Json?
  status   ImportBatchStatus @default(UPLOADED)
  errorLog Json?
  importedBy String?
  createdAt DateTime @default(now())
  finishedAt DateTime?

  entity  Entity                 @relation(fields: [entityId], references: [id], onDelete: Cascade)
  records HistoryInvoiceRecord[]
  filings HistoryFilingRecord[]
  statements FinancialStatementRecord[]

  @@unique([entityId, fileHash])
  @@index([entityId, sourceType, createdAt])
  @@map("history_import_batch")
}

/// 历史发票明细（销项 / 进项）
model HistoryInvoiceRecord {
  id       String             @id @default(uuid())
  entityId String
  batchId  String?
  direction InvoiceDirection /// 复用 OUTPUT 销项 / INPUT 进项
  kind     HistoryInvoiceKind @default(SPECIAL_VAT)

  invoiceCode   String?
  invoiceNumber String?
  invoiceDate   DateTime      @db.Date
  periodYear    Int
  periodMonth   Int

  counterpartyName String
  counterpartyTaxNo String?

  amountExclTax Decimal @db.Decimal(18, 2)
  taxRate       Decimal @db.Decimal(6, 4) @default(0)
  taxAmount     Decimal @db.Decimal(18, 2)
  amountInclTax Decimal @db.Decimal(18, 2)

  /// 该票是否已勾选认证/已抵扣（用户导入的"已勾稽进项发票"字段）
  isCertified   Boolean @default(false)
  /// 该票是否已用于税前扣除（缺票成本需要纳税调增）
  isDeducted    Boolean @default(true)
  isRedFlushed  Boolean @default(false)

  /// 票面品名摘要（用于 AI 归类）
  itemSummary String?
  /// AI 归类的费用/存货类别（如 办公费 / 差旅费 / 原材料），人工可改
  aiCategory  String?
  aiConfidence Decimal? @db.Decimal(5, 4)

  /// 与该记录核对的申报记录（按期间+税种）
  reconPeriodLabel String?
  reconStatus HistoryReconStatus @default(PENDING)
  reconNote   String?
  /// ★ 去重键：同主体+方向+代码+号码+红冲标记
  dedupHash   String

  createdAt DateTime @default(now())

  entity Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  batch  HistoryImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([entityId, dedupHash])
  @@index([entityId, direction, periodYear, periodMonth])
  @@index([entityId, reconStatus])
  @@map("history_invoice_record")
}

/// 历史申报记录（增值税 / 所得税 / 附加税费）
model HistoryFilingRecord {
  id       String             @id @default(uuid())
  entityId String
  batchId  String?
  filingType HistoryFilingType

  periodLabel String /// "2023-01" 月报 | "2023Q1" 季报 | "2023" 年报
  periodYear  Int
  periodMonth Int?
  periodQuarter Int?

  /// 销售额（不含税）—— 增值税申报表主表第1行 + 第5行
  salesExclTax Decimal? @db.Decimal(18, 2)
  /// 销项税额 —— 主表第11行
  outputTax    Decimal? @db.Decimal(18, 2)
  /// 进项税额 —— 主表第12行
  inputTax     Decimal? @db.Decimal(18, 2)
  /// 进项税额转出 —— 主表第14行
  inputTaxTransferOut Decimal? @db.Decimal(18, 2)
  /// 上期留抵
  taxCreditBroughtForward Decimal? @db.Decimal(18, 2)
  /// 应纳税额合计 —— 主表第24行
  taxPayable   Decimal? @db.Decimal(18, 2)
  /// 本期已缴税额 —— 主表第27行
  taxPaid      Decimal? @db.Decimal(18, 2)
  /// 期末未缴税额 —— 主表第32行
  taxUnpaidEnd Decimal? @db.Decimal(18, 2)
  /// 城建税 + 教育费附加 + 地方教育附加 合计
  surtax       Decimal? @db.Decimal(18, 2)

  /// 企业所得税：营业收入 / 营业成本 / 利润总额 / 实际应纳所得税额
  citRevenue      Decimal? @db.Decimal(18, 2)
  citCost         Decimal? @db.Decimal(18, 2)
  citProfitBefore Decimal? @db.Decimal(18, 2)
  citTaxPayable   Decimal? @db.Decimal(18, 2)
  citTaxPaid      Decimal? @db.Decimal(18, 2)
  /// 纳税调整增加额（无票成本等）
  citAdjustUp     Decimal? @db.Decimal(18, 2)

  rawRow Json?
  reconStatus HistoryReconStatus @default(PENDING)
  reconNote   String?

  createdAt DateTime @default(now())

  entity Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  batch  HistoryImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([entityId, filingType, periodLabel])
  @@index([entityId, periodYear])
  @@map("history_filing_record")
}

/// 历史财务报表（资产负债表 / 利润表 / 现金流量表）
///
/// 为什么值得单独建表：
///   税务申报表能推出"应交多少税"，但推不出"资产与负债的实际构成"。
///   如果能拿到代账公司出的资产负债表，期初建账就有了一半的真实数据 ——
///   货币资金、存货、固定资产、实收资本这些"算不出来只能问人"的科目，
///   直接从表里取数即可，不必倒轧。
///   所以财务报表是历史重建里**价值最高的一类输入**。
model FinancialStatementRecord {
  id       String                 @id @default(uuid())
  entityId String
  batchId  String?
  statementType FinancialStatementType

  /// 报表日期（资产负债表为时点数）
  statementDate DateTime @db.Date
  /// 所属年度 / 月份，便于按年归集
  fiscalYear Int
  fiscalMonth Int?

  /// 数据来源：人工提供 / 识别 / 手工录入
  source   String @default("RECOGNITION")
  /// 报表口径：一般企业 / 小企业会计准则
  standard String @default("SMALL_ENTERPRISE_2013")

  /// ★ 报表行项目：{ itemCode: { label, endBalance, beginBalance } }
  ///   保留原始行项目而不强行映射科目 —— 不同版本报表行次有差异，
  ///   映射留到重建阶段按需做，原始数据先如实存下来。
  items Json

  /// 关键合计项，便于快速取用与核对
  totalAssets        Decimal? @db.Decimal(18, 2)
  totalLiabilities   Decimal? @db.Decimal(18, 2)
  totalEquity        Decimal? @db.Decimal(18, 2)
  revenue            Decimal? @db.Decimal(18, 2)
  cost               Decimal? @db.Decimal(18, 2)
  profitBeforeTax    Decimal? @db.Decimal(18, 2)
  netProfit          Decimal? @db.Decimal(18, 2)

  /// 完整性自检：资产 = 负债 + 所有者权益
  isBalanced       Boolean @default(true)
  balanceDifference Decimal? @db.Decimal(18, 2)

  rawRow Json?
  /// 识别来源单据（便于回看原件）
  documentId String?
  reconNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  batch  HistoryImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([entityId, statementType, statementDate])
  @@index([entityId, fiscalYear])
  @@map("financial_statement_record")
}

/// 年度重建结果（每个历史年度一条，记录推演过程与依据）
model HistoryReconstruction {
  id       String @id @default(uuid())
  entityId String
  year     Int
  status   ReconstructionStatus @default(PENDING)
  /// 重建过程中的步骤状态，支持断点续跑
  steps    Json?

  // ---- 发票侧（有据可查）----
  salesInvoiceCount    Int     @default(0)
  salesAmountExclTax   Decimal @db.Decimal(18, 2) @default(0)
  salesTaxAmount       Decimal @db.Decimal(18, 2) @default(0)
  purchaseInvoiceCount Int     @default(0)
  purchaseAmountExclTax Decimal @db.Decimal(18, 2) @default(0)
  purchaseTaxAmount    Decimal @db.Decimal(18, 2) @default(0)
  certifiedTaxAmount   Decimal @db.Decimal(18, 2) @default(0)

  // ---- 申报侧（有据可查）----
  declaredSalesExclTax Decimal? @db.Decimal(18, 2)
  declaredOutputTax    Decimal? @db.Decimal(18, 2)
  declaredInputTax     Decimal? @db.Decimal(18, 2)
  declaredTaxPayable   Decimal? @db.Decimal(18, 2)
  declaredTaxPaid      Decimal? @db.Decimal(18, 2)
  declaredSurtax       Decimal? @db.Decimal(18, 2)

  // ---- 核对结果 ----
  /// 发票聚合 vs 申报表 的差异
  salesDiff   Decimal? @db.Decimal(18, 2)
  purchaseDiff Decimal? @db.Decimal(18, 2)
  /// 差异说明（发票口径与申报口径可能不同：有未开票收入、跨期认证等）
  reconciliationNote String?

  // ---- 倒轧推算（★ 推算项，需人工确认）----
  /// 税前利润（取自所得税年报）
  profitBeforeTax Decimal? @db.Decimal(18, 2)
  /// 推算的营业成本 = 营业收入 − 利润总额 − 费用估算
  derivedCost     Decimal? @db.Decimal(18, 2)
  /// 有票成本（进项发票里已用于税前扣除的部分）
  invoicedCost    Decimal? @db.Decimal(18, 2)
  /// ★ 无票成本 = 推算成本 − 有票成本（汇算清缴需纳税调增的部分）
  costWithoutInvoice Decimal? @db.Decimal(18, 2)

  incomeTaxExpense Decimal? @db.Decimal(18, 2)
  incomeTaxPayable Decimal? @db.Decimal(18, 2)
  netProfit        Decimal? @db.Decimal(18, 2)

  /// 需要人工补录的项 [{ field, label, reason, suggestion }]
  requiredInputs Json?
  /// AI 的分析与提示
  aiSummary String?
  aiWarnings Json?

  confirmedBy String?
  confirmedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, year])
  @@index([entityId, status])
  @@map("history_reconstruction")
}

/// 期初建账方案（重建的最终产出，人工确认后才生成期初凭证）
model OpeningBalanceProposal {
  id       String @id @default(uuid())
  entityId String
  /// 方案对应的启用期间（期初余额落在该期间）
  targetPeriodId String
  targetYear     Int
  targetMonth    Int
  status OpeningProposalStatus @default(DRAFT)

  totalDebit  Decimal @db.Decimal(18, 2) @default(0)
  totalCredit Decimal @db.Decimal(18, 2) @default(0)
  /// 借贷差额（必须为 0 才能生成凭证）
  difference  Decimal @db.Decimal(18, 2) @default(0)

  /// 现金科目采用哪种口径：DECLARED 用户提供银行余额 | DERIVED 由恒等式倒轧
  cashBasis String @default("DERIVED")
  /// 用户提供的实际银行/现金余额（若有）
  actualCashBalance Decimal? @db.Decimal(18, 2)

  aiSummary String?
  warnings  Json?
  /// 生成期初凭证后回填
  voucherId String?
  postedAt  DateTime?

  confirmedBy String?
  confirmedAt DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity  Entity                     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  lines   OpeningBalanceLine[]
  sources OpeningBalanceSourceRef[]

  @@index([entityId, status])
  @@map("opening_balance_proposal")
}

/// 期初方案的每一行（★ 每行都必须标明来源，让人一眼区分"有据"与"推算"）
model OpeningBalanceLine {
  id          String @id @default(uuid())
  proposalId  String
  lineNo      Int
  accountId   String
  accountCode String
  accountName String

  direction BalanceDirection
  amount    Decimal          @db.Decimal(18, 2)

  /// ★ 数据来源，决定这一行有多可信
  source     OpeningSource
  /// 人类可读的来源说明，如 "取 2024 年 12 月增值税申报表主表第32行"
  sourceNote String
  /// 该行涉及的金额构成（如 应收账款 = 各年销项价税合计 − 已收款）
  breakdown  Json?
  /// 是否需要人工确认或调整
  needsReview Boolean @default(false)

  proposal OpeningBalanceProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("opening_balance_line")
}

/// 期初方案与原始数据的溯源关联（回答"这个数字从哪来"）
model OpeningBalanceSourceRef {
  id         String @id @default(uuid())
  proposalId String
  /// HISTORY_INVOICE | HISTORY_FILING | HISTORY_RECONSTRUCTION | MANUAL | AI
  refType    String
  refId      String?
  /// 说明，如 "2023年销项发票 128 张，价税合计 1,234,567.89"
  note       String
  amount     Decimal? @db.Decimal(18, 2)

  proposal OpeningBalanceProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("opening_balance_source_ref")
}