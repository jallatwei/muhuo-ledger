/// 税务档案（所有可变税务参数都放这里，绝不硬编码）
model TaxProfile {
  id       String       @id @default(uuid())
  entityId String       @unique
  taxpayerType TaxpayerType @default(GENERAL)

  vatFilingCycle   String @default("MONTHLY") /// MONTHLY | QUARTERLY
  citPrepayCycle   String @default("QUARTERLY")
  /// 小型微利企业（影响所得税优惠）
  isSmallLowProfit Boolean @default(true)

  /// 附加税费率 {city:0.07, edu:0.03, localEdu:0.02}
  surtaxRates      Json
  /// 六税两费减半 -> 0.5
  surtaxReduction  Decimal? @db.Decimal(6, 4)
  /// 城建税所在地档次：CITY 7% | COUNTY 5% | OTHER 1%
  surtaxLocation   String   @default("CITY")

  /// 进项发票认证模式：AUTO_ON_IMPORT | MANUAL
  invoiceCertMode  String   @default("AUTO_ON_IMPORT")

  /// 小微企业优惠：应纳税所得额减按比例计入
  smallProfitDeductionRate Decimal? @db.Decimal(6, 4) /// 0.25
  smallProfitTaxRate       Decimal? @db.Decimal(6, 4) /// 0.20
  /// 政策文号与生效期，UI 上要展示，便于用户核对
  policyNote       String?
  policyEffectiveFrom DateTime? @db.Date
  policyEffectiveTo   DateTime? @db.Date

  updatedAt DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@map("tax_profile")
}

/// 税期（与会计期间解耦：增值税月报、企业所得税季报）
model TaxPeriod {
  id       String @id @default(uuid())
  entityId String
  taxType  String /// VAT | SURTAX | CIT_PREPAY | STAMP_DUTY
  year     Int
  quarter  Int?
  month    Int?
  label    String /// "2025-03" 或 "2025Q1"
  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date
  status   String   @default("OPEN") /// OPEN | AGGREGATED | DECLARED | CLOSED

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, taxType, label])
  @@index([entityId, taxType, year])
  @@map("tax_period")
}

/// 发票认证/勾选记录
model VatCertification {
  id        String   @id @default(uuid())
  entityId  String
  invoiceId String
  periodId  String /// 勾选认证所属期
  certifiedAt DateTime @default(now())
  certifiedBy String?
  method    String   @default("HOOK") /// HOOK 勾选 | SCAN 扫描认证 | IMPORT 批量导入
  deductibleTax Decimal @db.Decimal(18, 2) /// 本次可抵扣税额
  status    String   @default("CERTIFIED") /// CERTIFIED | REVOKED
  remark    String?

  entity  Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, periodId])
  @@index([entityId, periodId])
  @@map("vat_certification")
}

/// 增值税归集结果（申报表底稿）
model VatPeriodAggregate {
  id          String @id @default(uuid())
  entityId    String
  taxPeriodId String
  /// 销项按税率分档：[{rate, salesExclTax, taxAmount, ...}] → 附列资料一
  outputTax   Json
  /// 进项按凭证类型分档 → 附列资料二
  inputTax    Json
  taxPayable      Decimal @db.Decimal(18, 2) @default(0)
  taxCredited     Decimal @db.Decimal(18, 2) @default(0) /// 上期留抵
  taxPayableFinal Decimal @db.Decimal(18, 2) @default(0)
  /// 附加税费明细
  surtax      Json
  generatedAt DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, taxPeriodId])
  @@map("vat_period_aggregate")
}

/// 申报表实例
model TaxFiling {
  id          String @id @default(uuid())
  entityId    String
  taxType     String /// VAT | SURTAX | CIT_PREPAY | STAMP_DUTY
  taxPeriodId String
  status      String   @default("DRAFT") /// DRAFT | CONFIRMED | FILED
  /// 申报表全部行项目数值
  payload     Json
  /// 与账上科目的勾稽校验结果
  tieOut      Json?
  filedAt     DateTime?
  filedBy     String?
  receiptNo   String? /// 申报回执号

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, taxType, taxPeriodId])
  @@map("tax_filing")
}

