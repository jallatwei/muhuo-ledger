// =============================================================================
//  小企业自动记账系统 — 数据模型
//  ============================================================================
//  金额字段一律 Decimal(18,2)，代码侧用 Decimal，禁止 float。
//  本文件的权威设计说明见 design/02-数据模型.md，改 schema 必须先改那份文档。
//
//  设计红线（见 design/00 第 3 节）：
//    ① 借贷永远平衡   ② 同一张单据绝不重复入账   ③ 已结账的账改不动
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
//  枚举
// =============================================================================

/// 纳税人身份
enum TaxpayerType {
  GENERAL // 一般纳税人
  SMALL_SCALE // 小规模纳税人
}

/// 会计期间状态机：OPEN -> CLOSING -> CLOSED，反结账回到 OPEN
enum PeriodStatus {
  OPEN // 可增删改凭证
  CLOSING // 结账施工中，禁止凭证写入
  CLOSED // 完全冻结
}

/// 科目类别
enum AccountCategory {
  ASSET // 资产
  LIABILITY // 负债
  EQUITY // 所有者权益
  COST // 成本
  PROFIT_LOSS // 损益
}

/// 余额正常方向
enum BalanceDirection {
  DEBIT
  CREDIT
}

/// 辅助核算维度
enum AuxDimension {
  CUSTOMER
  SUPPLIER
  EMPLOYEE
  PROJECT
  DEPARTMENT
  CONTRACT
}

/// 凭证状态机
enum VoucherStatus {
  DRAFT // 草稿
  REVIEWING // 待审核
  APPROVED // 已审核，未过账（尚未分配凭证号）
  POSTED // 已过账（已分配凭证号，参与余额计算）
  REVERSED // 已被红冲（分录仍参与余额计算）
  VOID // 已作废
}

/// 凭证来源
enum VoucherSource {
  MANUAL
  INVOICE
  BANK
  PAYROLL
  CLOSING
  OPENING
}

/// 单据类型
enum DocType {
  INVOICE_SALES
  INVOICE_PURCHASE
  BANK_SLIP
  BANK_STATEMENT
  CONTRACT
  RECEIPT
  OTHER
}

enum DocSource {
  UPLOAD
  WATCH_FOLDER
  EMAIL
  SCAN
}

enum DocumentStatus {
  PENDING
  EXTRACTING
  EXTRACTED
  REVIEW_REQUIRED
  FAILED
  ARCHIVED
}

/// 往来单位角色
enum PartnerRole {
  CUSTOMER
  SUPPLIER
  BOTH
  EMPLOYEE
  OTHER
}

/// 发票方向
enum InvoiceDirection {
  OUTPUT // 销项
  INPUT // 进项
}

/// 发票种类
enum InvoiceCategory {
  SPECIAL_VAT // 增值税专用发票
  GENERAL_VAT // 增值税普通发票
  E_INVOICE // 全电发票（数电票）
  TRAIN // 火车票
  AIR // 航空运输电子客票行程单
  TOLL // 通行费发票
  OTHER
}

enum InvoiceStatus {
  IMPORTED // 已识别，待入账
  AUTO_DRAFTED // 已自动生成待确认凭证
  POSTED // 已入账
  MATCHED // 已匹配收付款
  RECONCILED // 已对账归档
  IGNORED // 人工标记不入账
  NEEDS_REVIEW // 置信度低或校验冲突
}

/// 规则触发点
enum RuleTrigger {
  INVOICE_INPUT
  INVOICE_OUTPUT
  BANK_IN
  BANK_OUT
  BANK_FEE
  BANK_INTEREST
  SALARY_ACCRUAL
  SALARY_PAYMENT
  DEPRECIATION
  AMORTIZATION
  TAX_PAYMENT
  OTHER
}

/// 风险级别与类别
enum RiskLevel {
  INFO
  WARNING
  CRITICAL
}

enum RiskCategory {
  TAX
  ACCOUNTING
  FRAUD
  COMPLIANCE
  AI
}

enum RiskAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

enum CloseRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  REVERTED
}
// =============================================================================
//  ⑧ 历史数据重建（专门服务于"以前没有账、只有开票与申报记录"的场景）
//  ============================================================================
//  设计前提（务必理解）：
//    只有开票记录 + 申报记录时，能**有据重建**的科目是有限的：
//      ✓ 收入、销项税额、进项税额、应交税费、所得税费用、应收账款、应付账款
//      ✗ 现金余额、成本费用、存货、固定资产、实收资本 —— 推不出来，必须问人或倒轧
//    所以本模块的产出是「期初建账方案」，每一行都标明数据来源：
//      DECLARED 申报表直接取数 / INVOICE 发票聚合 / DERIVED 倒轧推算 / MANUAL 人工补录
//    并强制人工确认后才允许生成期初凭证。
// =============================================================================

/// 导入来源方式
enum HistorySourceType {
  INVOICE_SALES // 销项开票明细
  INVOICE_PURCHASE // 进项发票明细
  VAT_FILING // 增值税申报记录
  CIT_FILING // 企业所得税年报/预缴记录
  FINANCIAL_STATEMENT // 财务报表（资产负债表 / 利润表 / 现金流量表）
  TAX_RETURN // 税务申报表（增值税 / 企业所得税等）
}

/// 发票性质
enum HistoryInvoiceKind {
  SPECIAL_VAT // 专票
  GENERAL_VAT // 普票
  E_INVOICE // 数电票
  TOLL // 通行费
  TRAIN // 火车票
  AIR // 机票
  OTHER
}

/// 申报表类型
enum HistoryFilingType {
  VAT_MONTHLY // 增值税月报
  VAT_QUARTERLY // 增值税季报
  CIT_QUARTERLY // 企业所得税季度预缴
  CIT_ANNUAL // 企业所得税年度汇算清缴
  SURTAX // 附加税费
  STAMP_DUTY // 印花税
}

/// 财务报表类型（历史资料导入用）
enum FinancialStatementType {
  BALANCE_SHEET // 资产负债表
  INCOME_STATEMENT // 利润表
  CASH_FLOW // 现金流量表
}

enum ImportBatchStatus {
  UPLOADED
  PARSING
  MAPPING
  IMPORTED
  FAILED
}

enum HistoryReconStatus {
  PENDING // 待处理
  MATCHED // 与申报记录一致
  MISMATCHED // 存在差异
  MANUAL // 人工确认过
  IGNORED
}

/// 重建步骤（每年一轮，可断点续跑）
enum ReconstructionStatus {
  PENDING
  INPUTS_READY // 发票与申报数据已就位
  RECONCILED // 已完成发票↔申报核对
  DERIVED // 已算出应纳税额与利润
  NEEDS_INPUT // 存在必须人工补录的项
  READY // 可生成期初方案
  CONFIRMED
  FAILED
}

/// 期初方案每一行的数据来源（★ 决定可信度，必须展示给用户）
enum OpeningSource {
  DECLARED // 申报表直接取数（最可信）
  INVOICE // 发票明细聚合（可信）
  DERIVED // 由恒等式倒轧（推算，需人工确认）
  MANUAL // 人工补录
}

enum OpeningProposalStatus {
  DRAFT
  CONFIRMED
  POSTED
  REJECTED
}

// =============================================================================
//  ① 组织与科目
// =============================================================================

/// 核算主体
model Entity {
  id                      String       @id @default(uuid())
  name                    String
  unifiedSocialCreditCode String? /// 统一社会信用代码
  taxpayerType            TaxpayerType @default(GENERAL)
  accountingStandard      String       @default("SMALL_ENTERPRISE_2013")
  baseCurrency            String       @default("CNY")
  taxAuthority            String? /// 主管税务机关
  address                 String?
  phone                   String?
  legalPerson             String? /// 法定代表人
  accountantName          String? /// 会计
  fiscalYearStartMonth    Int          @default(1)
  /// 是否启用凭证内核的数据库层强制约束（借贷平衡触发器、期间锁等）
  /// 仅在批量导入/修数时可临时关闭，开关变更本身写入审计日志
  bookkeepingEnforced     Boolean      @default(true)
  isActive                Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  periods            Period[]
  fiscalYears        FiscalYear[]
  accounts           Account[]
  partners           Partner[]
  contracts          Contract[]
  invoices           Invoice[]
  documents          Document[]
  bankTransactions   BankTransaction[]
  vouchers           JournalVoucher[]
  balances           AccountBalance[]
  rules              JournalRule[]
  overrides          ClassificationOverride[]
  taxProfile         TaxProfile?
  taxPeriods         TaxPeriod[]
  riskRules          RiskRule[]
  riskAlerts         RiskAlert[]
  closeRuns          PeriodCloseRun[]
  periodChecks       PeriodCheckResult[]
  accountMappings    AccountMapping[]
  certifications     VatCertification[]
  vatAggregates      VatPeriodAggregate[]
  taxFilings         TaxFiling[]
  extractions        ExtractionResult[]

  // ⑧ 历史数据重建
  historyBatches      HistoryImportBatch[]
  historyInvoices     HistoryInvoiceRecord[]
  historyFilings      HistoryFilingRecord[]
  reconstructions     HistoryReconstruction[]
  openingProposals    OpeningBalanceProposal[]
  financialStatements FinancialStatementRecord[]

  memberships Membership[]

  @@map("entity")
}

/// 会计期间（月）
model Period {
  id            String       @id @default(uuid())
  entityId      String
  fiscalYear    Int
  month         Int
  startsOn      DateTime     @db.Date
  endsOn        DateTime     @db.Date
  status        PeriodStatus @default(OPEN)
  closedAt      DateTime?
  closedBy      String?
  /// 反结账次数 —— 审计重点关注项
  reopenedCount Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, fiscalYear, month])
  @@index([entityId, status])
  @@map("period")
}

/// 会计年度
model FiscalYear {
  id       String    @id @default(uuid())
  entityId String
  year     Int
  status   String    @default("OPEN") /// OPEN | CLOSED
  closedAt DateTime?

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, year])
  @@map("fiscal_year")
}

/// 会计科目
model Account {
  id         String           @id @default(uuid())
  entityId   String
  code       String /// 科目编码，如 "22210101"
  name       String /// 科目名称
  fullName   String /// 含上级的完整名称，报表展示用
  parentId   String?
  level      Int /// 1..n
  category   AccountCategory
  direction  BalanceDirection /// 余额的正常方向
  /// ★ 只有末级科目允许记账（数据库触发器强制）
  isLeaf     Boolean          @default(true)
  isActive   Boolean          @default(true)

  // ---- 报表与申报映射 ----
  reportItem  String? /// 资产负债表/利润表行项目标识
  cashflowTag String? /// 现金流量表归类
  taxTag      String? /// 增值税归集标记，见 design/09 第 6 节
  /// 必须录入的辅助核算维度
  auxRequired AuxDimension[]

  /// 系统内置科目不可删除
  isSystem  Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity   Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  parent   Account? @relation("AccountTree", fields: [parentId], references: [id])
  children Account[] @relation("AccountTree")
  lines    JournalLine[]

  @@unique([entityId, code])
  @@index([entityId, parentId])
  @@index([entityId, reportItem])
  @@index([entityId, taxTag])
  @@map("account")
}

// =============================================================================
//  ② 业务单据
// =============================================================================

/// 原始单据文件（只增不改）
model Document {
  id           String         @id @default(uuid())
  entityId     String
  docType      DocType /// 用户导入时的声明类型
  detectedType DocType? /// AI 识别出的实际类型（与声明不符则触发风险提示）
  source       DocSource      @default(UPLOAD)
  originalName String
  mimeType     String
  sizeBytes    Int
  /// ★ SHA-256 内容哈希：文件级去重与幂等的基础
  contentHash  String
  storageKey   String /// 存储路径或对象存储 key
  pageCount    Int?
  status       DocumentStatus @default(PENDING)
  errorMessage String?
  uploadedBy   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  entity      Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)
  extractions ExtractionResult[]
  invoices    Invoice[]

  /// ★ 同一主体的同一文件只入库一次
  @@unique([entityId, contentHash])
  @@index([entityId, status])
  @@index([entityId, docType])
  @@map("document")
}

/// 往来单位
model Partner {
  id               String        @id @default(uuid())
  entityId         String
  name             String /// 标准化后的名称
  /// 见过的所有原始写法，用于模糊匹配
  rawNames         String[]
  role             PartnerRole[]
  /// ★ 纳税人识别号：匹配的第一优先级
  taxNo            String?
  bankName         String?
  bankAccount      String?
  addressPhone     String?
  /// 该供应商费用的默认科目（L2 历史学习的成果）
  defaultAccountId String?
  /// 默认往来科目（应收/应付）
  defaultArApAccountId String?
  riskLevel        String        @default("NORMAL") /// NORMAL | WATCH | BLOCK
  remark           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, taxNo])
  @@index([entityId, name])
  @@map("partner")
}

/// 合同（辅助/备查定位：不产生分录，只做关联与风险比对）
model Contract {
  id             String    @id @default(uuid())
  entityId       String
  contractNo     String?
  name           String
  counterpartyId String?
  direction      String /// IN 采购 | OUT 销售
  amountInclTax  Decimal   @db.Decimal(18, 2)
  taxRate        Decimal?  @db.Decimal(6, 4)
  signDate       DateTime? @db.Date
  startDate      DateTime? @db.Date
  endDate        DateTime? @db.Date
  status         String    @default("ACTIVE") /// ACTIVE | FINISHED | TERMINATED
  documentId     String? /// 合同扫描件
  remark         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId, direction])
  @@index([entityId, counterpartyId])
  @@map("contract")
}

/// 发票
model Invoice {
  id               String          @id @default(uuid())
  entityId         String
  direction        InvoiceDirection
  category         InvoiceCategory
  /// 发票代码（纸质/老电票 10 或 12 位）
  invoiceCode      String?
  /// 发票号码（数电票为 20 位）
  invoiceNumber    String
  digitalInvoiceNo String? /// 数电票 20 位号码
  invoiceDate      DateTime        @db.Date

  sellerTaxNo String?
  sellerName  String
  buyerTaxNo  String?
  buyerName   String

  /// 不含税金额
  amountExclTax Decimal @db.Decimal(18, 2)
  taxRate       Decimal @db.Decimal(6, 4)
  taxAmount     Decimal @db.Decimal(18, 2)
  /// 价税合计
  amountInclTax Decimal @db.Decimal(18, 2)

  isRedFlushed      Boolean @default(false) /// 是否红字发票
  originalInvoiceId String? /// 红冲指向的原票
  /// 是否可抵扣。集体福利/个人消费/餐饮娱乐等为 false → 税额计入成本，不产生税行
  isDeductible      Boolean @default(true)
  /// PURCHASE_MATERIAL | PURCHASE_SERVICE | EXPENSE | FIXED_ASSET | SALES
  businessType      String?

  accountId   String? /// 费用类发票的对方科目（规则引擎或人工指定）
  partnerId   String?
  contractId  String?
  documentId  String? /// 原始图片/PDF
  extractionId String? /// 对应抽取结果
  matchedTransactionId String? /// 已匹配的银行流水

  status      InvoiceStatus @default(IMPORTED)
  reviewNote  String? /// 人工复核备注（IGNORED 时必填理由）
  reviewedBy  String?
  reviewedAt  DateTime?
  /// ★ 归一化后的业务去重键
  dedupHash   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity        Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  document      Document?      @relation(fields: [documentId], references: [id])
  lines         InvoiceLine[]
  certifications VatCertification[]
  journalLines  JournalLine[]

  /// ★ 业务唯一键：防止同一张票被不同文件重复导入
  @@unique([entityId, direction, invoiceCode, invoiceNumber, isRedFlushed])
  @@index([entityId, invoiceDate])
  @@index([entityId, status])
  @@index([entityId, dedupHash])
  @@index([entityId, partnerId])
  @@map("invoice")
}

/// 发票明细行（数电票与现代专票都有，用于把一张票拆到多个科目）
model InvoiceLine {
  id            String   @id @default(uuid())
  invoiceId     String
  lineNo        Int
  itemName      String
  spec          String?
  unit          String?
  quantity      Decimal? @db.Decimal(18, 4)
  unitPrice     Decimal? @db.Decimal(18, 6)
  amountExclTax Decimal  @db.Decimal(18, 2)
  taxRate       Decimal  @db.Decimal(6, 4)
  taxAmount     Decimal  @db.Decimal(18, 2)
  accountId     String? /// 该明细对应的科目

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line")
}

/// 银行流水 / 回单
model BankTransaction {
  id            String   @id @default(uuid())
  entityId      String
  accountId     String? /// 会计科目（银行存款明细）
  bankAccountNo String
  txnDate       DateTime @db.Date
  direction     String /// IN 收 | OUT 付
  amount        Decimal  @db.Decimal(18, 2)
  balanceAfter  Decimal? @db.Decimal(18, 2)

  counterpartyName      String?
  counterpartyAccountNo String?
  summary               String? /// 摘要/用途
  bankSerialNo          String? /// 银行流水号

  /// 去重：银行流水号优先；无则 日期+金额+对方账号+摘要 哈希
  dedupHash String
  /// 会计上的对方科目（自动匹配或人工指定）
  counterpartAccountId String?
  matchStatus          String  @default("UNMATCHED") /// UNMATCHED|AUTO_MATCHED|MANUAL_MATCHED|IGNORED
  sourceDocumentId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity         Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  allocations    PaymentAllocation[]

  @@unique([entityId, dedupHash])
  @@index([entityId, txnDate])
  @@index([entityId, matchStatus])
  @@map("bank_transaction")
}

/// 收付款核销（发票与流水的多对多）
model PaymentAllocation {
  id            String   @id @default(uuid())
  entityId      String
  invoiceId     String
  transactionId String
  amount        Decimal  @db.Decimal(18, 2)
  allocatedAt   DateTime @default(now())
  allocatedBy   String?
  isAuto        Boolean  @default(true)

  transaction BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, transactionId])
  @@index([entityId])
  @@map("payment_allocation")
}

/// 单据关联图（合同 ↔ 发票 ↔ 流水 ↔ 凭证）
model DocumentLink {
  id       String @id @default(uuid())
  entityId String
  fromType String /// CONTRACT | INVOICE | BANK_TRANSACTION | VOUCHER | DOCUMENT
  fromId   String
  toType   String
  toId     String
  linkType String /// FULFILLS 履约 | PAYMENT 收付款 | REFERENCE 参考 | REVERSES 红冲 | ATTACHMENT 附件
  createdAt DateTime @default(now())

  @@unique([fromType, fromId, toType, toId, linkType])
  @@index([entityId])
  @@map("document_link")
}

// =============================================================================
//  ③ 会计内核
// =============================================================================

/// 记账凭证
model JournalVoucher {
  id          String        @id @default(uuid())
  entityId    String
  periodId    String /// ★ 冗余存期间，锁期校验快
  /// ★ 期间年月冗余：PostgreSQL 唯一索引无法跨表 join，
  ///   凭证号唯一性依赖这两列。由应用层保证与 periodId 一致。
  periodYear  Int
  periodMonth Int

  voucherWord String        @default("记") /// 记 / 收 / 付 / 转 / 年初
  /// ★ 凭证号在过账时才分配，草稿没有号
  voucherNo   Int
  voucherDate DateTime      @db.Date
  status      VoucherStatus @default(DRAFT)

  totalDebit  Decimal @db.Decimal(18, 2)
  totalCredit Decimal @db.Decimal(18, 2)

  summary     String /// 主摘要
  attachments Int     @default(0) /// 附件张数（打印凭证册用）

  sourceType VoucherSource
  sourceId   String? /// 来源业务对象 id

  /// ★ 幂等键：同一来源 + 同一规则版本只可能有一张非作废凭证
  idempotencyKey String?
  /// 命中的规则（可追溯）
  ruleId         String?
  /// ★ 人类可读的命中理由，写入凭证备注，回答"为什么这么记"
  ruleReason     String?
  ruleVersion    Int?
  /// 该凭证整体置信度
  confidence     Decimal? @db.Decimal(5, 4)

  reviewedBy String?
  reviewedAt DateTime?
  /// 最近一次退回的理由（审核退回 / 过账前退回 / 反审核）
  /// ★ 必须回显给制单人，否则"被退了却不知道为什么"，流程就卡住了
  reviewNote String?
  postedBy   String?
  postedAt   DateTime?

  reversedById String? /// 被哪张凭证红冲
  reversesId   String? /// 本张红冲了哪张
  voidReason   String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  lines  JournalLine[]

  /// ★ 凭证号唯一（部分唯一索引，只对 voucherNo > 0 生效）。
  ///
  ///   为什么不能写成 @@unique([...voucherNo])：
  ///   草稿的 voucherNo 是 0（未编号），而 0 是一个**真实的取值**，
  ///   于是同一期间的第二张草稿会撞唯一约束 —— 表现为"建第二张凭证就报
  ///   系统内部错误"。我们验证过：这个 bug 会让一个期间只能存在一张草稿。
  ///
  ///   Prisma schema 无法表达部分索引（WHERE 子句），所以索引在迁移 SQL 里建：
  ///     CREATE UNIQUE INDEX ... ON journal_voucher (...) WHERE "voucherNo" > 0;
  ///
  ///   这条索引同时保住了"凭证号在同一期间连续无重复"这个真正的约束目标。
  @@index([entityId, voucherWord, periodYear, periodMonth, voucherNo])
  /// ★ 幂等兜底
  @@unique([entityId, idempotencyKey])
  @@index([entityId, periodId, status])
  @@index([entityId, voucherDate])
  @@index([entityId, sourceType, sourceId])
  @@map("journal_voucher")
}

/// 凭证号分配器（行锁表）
/// ★ 绝不用 MAX(voucherNo)+1 —— 并发会重号
model VoucherSequence {
  id          String @id @default(uuid())
  entityId    String
  periodId    String
  voucherWord String
  nextNo      Int    @default(1)

  @@unique([entityId, periodId, voucherWord])
  @@map("voucher_sequence")
}

/// 分录行
model JournalLine {
  id       String @id @default(uuid())
  voucherId String
  entityId String
  periodId String
  lineNo   Int

  accountId String
  direction BalanceDirection
  /// ★ 恒为正数。借贷方向由 direction 表达，绝不用负数金额。
  amount    Decimal          @db.Decimal(18, 2)

  summary String?

  // ---- 辅助核算 ----
  partnerId     String?
  auxProject    String?
  auxDepartment String?
  contractId    String?

  // ---- 税相关（用于申报表归集与追溯）----
  taxRate   Decimal? @db.Decimal(6, 4)
  taxAmount Decimal? @db.Decimal(18, 2)
  invoiceId String?

  createdAt DateTime @default(now())

  voucher JournalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account Account        @relation(fields: [accountId], references: [id])
  invoice Invoice?       @relation(fields: [invoiceId], references: [id])

  @@index([entityId, periodId, accountId]) // 科目余额表 / 明细账
  @@index([entityId, accountId, voucherId])
  @@index([voucherId])
  @@index([invoiceId])
  @@index([entityId, partnerId])
  @@map("journal_line")
}

/// 科目余额（按期存储，可幂等重算）
model AccountBalance {
  id       String @id @default(uuid())
  entityId String
  periodId String
  accountId String

  openingDebit  Decimal @db.Decimal(18, 2) @default(0)
  openingCredit Decimal @db.Decimal(18, 2) @default(0)
  debitOccurred Decimal @db.Decimal(18, 2) @default(0)
  creditOccurred Decimal @db.Decimal(18, 2) @default(0)
  closingDebit  Decimal @db.Decimal(18, 2) @default(0)
  closingCredit Decimal @db.Decimal(18, 2) @default(0)

  updatedAt DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, periodId, accountId])
  @@index([entityId, periodId])
  @@map("account_balance")
}

/// 月结执行记录（支持断点续跑）
model PeriodCloseRun {
  id       String        @id @default(uuid())
  entityId String
  periodId String
  attempt  Int           @default(1)
  status   CloseRunStatus @default(RUNNING)
  /// 每步状态与耗时，便于断点续跑
  steps    Json
  startedBy String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  failureReason String?

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId, periodId])
  @@map("period_close_run")
}

/// 结账检查清单结果
model PeriodCheckResult {
  id       String @id @default(uuid())
  entityId String
  periodId String
  code     String /// 检查项代码，见 shared/enums 的 PERIOD_CHECK
  level    String /// BLOCKER | WARNING | INFO
  passed   Boolean
  detail   String?
  metrics  Json?
  checkedAt DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, periodId, code])
  @@map("period_check_result")
}

