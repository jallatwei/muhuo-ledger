# ============================================================
#  开发环境配置模板（本地 Docker）
#  用法：cp deploy/env/.env.dev.example deploy/env/.env.dev
#       然后按需修改。真实 .env.dev 已在 .gitignore 中，不会入库。
# ============================================================

# ---- 运行模式 ----
NODE_ENV=development
TZ=Asia/Shanghai

# ---- 数据库（容器内主机名固定为 postgres，端口固定 5432） ----
POSTGRES_USER=bookkeeper
POSTGRES_PASSWORD=bookkeeper_dev_pwd
POSTGRES_DB=bookkeeper_dev
DATABASE_URL=postgresql://bookkeeper:bookkeeper_dev_pwd@postgres:5432/bookkeeper_dev?schema=public

# 宿主机映射端口（避免与本机已装的 PostgreSQL 冲突）
POSTGRES_HOST_PORT=5433

# ---- 服务端口 ----
API_PORT=3000
API_HOST_PORT=3000
WEB_PORT=5173
WEB_HOST_PORT=5173

# 浏览器访问 API 的地址（前端构建时注入）
VITE_API_BASE_URL=http://localhost:3000/api
API_BASE_URL=http://localhost:3000/api

# 允许的跨域来源（开发态包含 Vite 默认端口）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 认证 ----
# ⚠️ 生产环境必须替换为随机值：openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me-in-production
JWT_EXPIRES_IN=12h

# ---- 登录要求 ----
# 本地开发设为 false：既有 e2e 验证脚本直接打接口、不带令牌。
# ★ 它的语义是「不*强制*登录」——只要请求带了令牌，
#   仍然会校验「你是不是这家公司的成员」，带别人的 entityId 照样 403。
# 云端部署必须改为 true（见 .env.prod.example）。
AUTH_REQUIRED=false

# ---- 单据文件存储 ----
# local = 容器内卷；s3 = 对象存储（云端用）
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/data/attachments
STORAGE_MAX_FILE_MB=50

# ============================================================
#  AI 识图适配层
#  AI_PROVIDER=mock   → 离线、零成本、结果确定，开发默认
#  切换真实模型只需改下面四行（都走 OpenAI 兼容协议）
# ============================================================
AI_PROVIDER=mock

# --- 示例 A：通义千问 VL（阿里云百炼）---
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_API_KEY=sk-xxxxxxxxxxxxxxxx
# AI_VISION_MODEL=qwen-vl-max
# AI_TEXT_MODEL=qwen-plus

# --- 示例 B：DeepSeek（文本能力强，视觉需另配）---
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-xxxxxxxxxxxxxxxx
# AI_VISION_MODEL=deepseek-vl2
# AI_TEXT_MODEL=deepseek-chat

# --- 示例 C：本机 Ollama / vLLM（数据不出内网）---
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_API_KEY=ollama
# AI_VISION_MODEL=qwen2.5-vl:7b
# AI_TEXT_MODEL=qwen2.5:14b

# 仅在 AI_PROVIDER != mock 时生效
AI_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=
AI_TEXT_MODEL=
AI_TEMPERATURE=0
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# 低于此置信度 → 强制人工复核（0~1）
OCR_MIN_CONFIDENCE=0.85
# 低于此置信度的 AI 科目建议 → 强制人工（0~1）
AI_SUGGEST_MIN_CONFIDENCE=0.75
# AI 成本预算（元/天），超限自动熔断转人工
AI_DAILY_BUDGET=20

# ============================================================
#  记账行为开关
# ============================================================

# ★ 自动生成的凭证是否允许免人工审核直接过账。
#   强烈建议永远保持 false：人工点一次确认只要 2 秒，
#   而一张错凭证的排查成本是 20 分钟。
BOOKKEEPING_AUTO_POST=false

# 自动过账的金额上限（仅当上一项为 true 时生效）
BOOKKEEPING_AUTO_POST_MAX_AMOUNT=1000

# 启用数据库层强制约束（借贷平衡触发器、期间锁、末级科目校验）
# 仅在批量导入/修数时可临时关闭，关闭动作本身会写审计日志
BOOKKEEPING_DB_CONSTRAINTS=true

# 同一纠错特征被人工纠正多少次后，提示"是否创建自动规则"
RULE_PROMOTION_THRESHOLD=3

# ---- 后台作业 ----
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=2000
JOB_BATCH_SIZE=5

# ---- 日志 ----
LOG_LEVEL=debug
LOG_PRETTY=true
