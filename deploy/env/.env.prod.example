# ============================================================
#  云端 / 生产环境配置模板
#  用法：cp deploy/env/.env.prod.example deploy/env/.env.prod
#
#  ⚠️ 与开发环境的区别（见 design/01 第 2 节）：
#     · 不挂载源码，跑真实构建产物
#     · 密钥不落盘到镜像，由云密钥管理/环境注入
#     · 必须显式指定 CORS 来源与 HTTPS 终止
# ============================================================

NODE_ENV=production
TZ=Asia/Shanghai

# ---- 数据库（云端建议用 RDS / 云数据库，不要自建在应用容器里）----
POSTGRES_USER=bookkeeper
# ⚠️ 必须替换为强随机密码
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bookkeeper
# 云数据库内网地址
DATABASE_URL=postgresql://bookkeeper:CHANGE_ME_STRONG_PASSWORD@db-host:5432/bookkeeper?schema=public&connection_limit=20

# ---- 服务 ----
API_PORT=3000
API_BASE_URL=https://book.example.com/api
# ⚠️ 必须替换为实际域名，不要用 *
CORS_ORIGINS=https://book.example.com

# ---- 认证 ----
# ⚠️ 生成方式：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=12h
# ⚠️ 云端必须为 true：未登录一律 401。
#    设 false 会让任何人都能不打令牌直接读账 —— 只允许在本地跑 e2e 时临时使用。
AUTH_REQUIRED=true

# ---- 单据存储 ----
# ⚠️ 注意：STORAGE_DRIVER=s3 【尚未实现】。
#    StorageService 目前只有本地文件那一套（fs.writeFile / fs.readFile），
#    写上 s3 不会报错、也不会警告，文件仍然写进容器本地盘 ——
#    这是**静默失效**：本地 Docker 部署时看不出问题，
#    上云后容器重启一次，所有附件就再也读不出来，而数据库里的 storageKey
#    还指着一个已经不存在的路径。
#
#    发票原件是这套系统的审计凭证，所以上云前必须二选一：
#      · 实现对象存储驱动（推荐，容器无状态才好扩缩容）
#      · 由运维保证 /data/attachments 落在持久卷上，并与数据库同批次备份
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/data/attachments
STORAGE_MAX_FILE_MB=50
STORAGE_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
STORAGE_S3_BUCKET=bookkeeper-attachments
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_ACCESS_KEY_SECRET=
STORAGE_S3_REGION=cn-hangzhou

# ---- AI 识图 ----
# 生产建议接入真实多模态模型；若数据敏感可指向自建 vLLM/Ollama
AI_PROVIDER=openai-compatible
# ★ 小米 MiMo 的地址分两种，填错会直接 404 / 401，别凭印象填：
#     Token Plan 订阅用户   https://token-plan-cn.xiaomimimo.com/v1
#     按量付费 / 通用控制台 https://api.xiaomimimo.com/v1
#   两个域名的 Key 不通用，以控制台上「专属 Base URL」那一栏为准。
AI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# ★ 模型名只能是 mimo-v2.5 —— mimo-v2.5-pro 只支持文本，
#   不支持图片理解，用它识票会在请求阶段直接失败。
# ⚠️ 你的 MiMo token。本地 Docker 部署填在 deploy/env/.env.prod；
#    云端请走密钥管理 / 环境注入，不要落进镜像或版本库。
MIMO_API_KEY=CHANGE_ME_MIMO_TOKEN
# 通用回退变量（其他兼容服务商走这个，如 DeepSeek / 通义 / 豆包 / Ollama）
AI_API_KEY=
AI_VISION_MODEL=mimo-v2.5
AI_TEXT_MODEL=mimo-v2.5
AI_TEMPERATURE=0
# ★ 两行必看：MiMo 的深度思考**默认开启**，而开启状态会强制把
#   temperature / top_p 改成 1.0 / 0.95 —— 我们传的 0 被静默忽略，
#   等于把票据抽取的确定性丢掉了。
#   另外思考内容与最终回答共享输出上限，长思考会把 JSON 挤掉，
#   表现为"输出被截断"这种很难查的失败。
#   所以：发送 thinking 参数，并显式设为 disabled。
#   （thinking 不是 OpenAI 标准参数，未知参数会让部分服务商直接 400，
#     所以用 AI_SEND_THINKING_PARAM 单独控制是否发送。）
AI_SEND_THINKING_PARAM=true
AI_THINKING_ENABLED=false
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_DAILY_BUDGET=100
OCR_MIN_CONFIDENCE=0.85
AI_SUGGEST_MIN_CONFIDENCE=0.75

# ---- 记账行为 ----
# ★ 强烈建议永远保持 false：人工点一次确认只要 2 秒，
#   而一张错凭证的排查成本是 20 分钟。
BOOKKEEPING_AUTO_POST=false
BOOKKEEPING_AUTO_POST_MAX_AMOUNT=1000
# 生产环境必须保持 true —— 这是借贷平衡与期间锁的最后一道防线
BOOKKEEPING_DB_CONSTRAINTS=true
RULE_PROMOTION_THRESHOLD=3

# ---- 后台作业 ----
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=2000
JOB_BATCH_SIZE=5

# ---- 启动行为 ----
# 单实例部署保持 true：忘了跑迁移会得到一堆"列不存在"的怪错，很难定位。
# 多实例部署必须改 false，由流水线单独执行一次 prisma migrate deploy，
# 否则多个副本会同时迁移。
MIGRATE_ON_START=true

# ---- 日志 ----
LOG_LEVEL=info
LOG_PRETTY=false

# ============================================================
#  上线前检查清单
# ============================================================
#  [ ] JWT_SECRET 已用 openssl rand -hex 32 生成，且未提交到版本库
#  [ ] POSTGRES_PASSWORD 已替换为强随机密码
#  [ ] CORS_ORIGINS 已改为实际域名，不是 *
#  [ ] NODE_ENV=production（此时 /api/docs 会自动关闭）
#  [ ] 数据库已开启自动备份，且验证过恢复流程
#  [ ] 原始单据文件与数据库**同批次备份**（否则凭证册缺附件）
#  [ ] ⚠️ 对象存储：STORAGE_DRIVER=s3 尚未实现。确认 /data/attachments
#      落在持久卷上并已纳入备份，或先实现对象存储驱动
#  [ ] BOOKKEEPING_DB_CONSTRAINTS=true（触发器已随迁移安装）
#  [ ] BOOKKEEPING_AUTO_POST=false
#  [ ] 已修改种子里的默认管理员密码
#  [ ] 已删除 seed 创建的测试账号 test@bookkeeper.local
#      （seed 本身已拒绝在生产环境执行，但历史环境可能已存在）
#  [ ] HTTPS 已配置，证书未过期
#  [ ] MIGRATE_ON_START 与实例数匹配（多实例必须 false）
