# 行尾与文本规范化
# ============================================================
# ★ 为什么必须有这个文件
#
#   Windows 上 git 默认会把仓库里的 LF 换成 CRLF（刚才 git add 时已经警告
#   "LF will be replaced by CRLF"）。对绝大多数源文件无害，但有三个地方会坏：
#
#     · docker/**/*.sh —— 容器里是 Linux，CRLF 会让 shebang 变成
#       "#!/bin/sh\r"，报 "no such file or directory"（这个报错完全不提行尾，
#       极难定位）
#     · apps/api/prisma/migrations/*.sql —— 校验和是按内容算的，
#       一旦被改写，prisma migrate deploy 会认为迁移文件被篡改而拒绝执行
#     · tools/*.ps1 —— 用 pwsh 跑没问题，但与 Linux CI 共用时要一致
#
#   加了下面这些规则之后，行尾由**仓库**决定而不是由每台机器的
#   core.autocrlf 决定 —— 这正是不该依赖个人全局配置的原因。
# ============================================================

# 默认：所有文本文件在仓库里一律 LF
* text=auto eol=lf

# 二进制：不碰行尾，也不做 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.xlsx binary
*.xls  binary
*.docx binary
*.zip  binary
*.gz   binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# 明确要求 LF 的脚本（即使将来有人把 eol 规则改宽，这几条也要兜住）
*.sh   text eol=lf
*.sql  text eol=lf
Dockerfile text eol=lf

# PowerShell 脚本：pwsh 不挑行尾，但保持 LF 以便在 Linux 容器/CI 里也能跑
*.ps1  text eol=lf
*.psm1 text eol=lf

# 锁文件：不参与语言统计，也不做 diff 折叠以外的处理
pnpm-lock.yaml -diff linguist-generated
package-lock.json -diff linguist-generated

# 文档与源码：正常按文本处理
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
