# ---- 依赖 ----
node_modules/
.pnpm-store/

# ---- 构建产物 ----
dist/
build/
*.tsbuildinfo
.vite/

# ---- 环境变量：模板入库，真实配置绝不入库 ----
.env
.env.*
!.env.*.example
!**/env/.env.*.example

# ---- 运行时数据（本地开发卷） ----
deploy/volumes/*
!deploy/volumes/.gitkeep
!deploy/volumes/README.md

# ---- 上传的原始单据：含敏感财务数据，绝不入库 ----
storage/
uploads/
*.pdf
*.jpg
*.jpeg
*.png
!docs/**/*.png

# ---- 测试脚本生成的临时文件 ----
apps/api/tmp/
tools/tmp/

# ---- 数据库与备份 ----
*.sql.gz
*.dump
backups/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.log
npm-debug.log*
pnpm-debug.log*

# ---- 测试 ----
coverage/
.nyc_output/

# 临时文件（提交信息、脚本中间产物）
tools/_commit-msg.txt
tools/_*.txt
